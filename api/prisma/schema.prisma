generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum SaleStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  SALE
  // D3: additive initial stock load (docs/production-v1/07-inventory-ledger.md §4).
  INITIAL_STOCK
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD_DEBIT
  CARD_CREDIT
  QR
}

// Block 1: Sale.pricingMode, the single authoritative price-mode fact for
// every line of the sale (SaleItem.unitPrice is the immutable snapshot taken
// from the matching catalog column). LIST is the ordinary retail price
// (ProductVariant.price); WHOLESALE (ProductVariant.wholesalePrice) is
// enabled per sale by a server-validated code and confirmed by a cashier.
// There is deliberately no CASH value: a cash-price mode is not offered
// (AGENTS.md, 2026-10-02 supersession).
enum PriceType {
  LIST
  WHOLESALE
}

enum CustomerPriceMode {
  CASH
  LIST
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  QR
}

// R3 (design rev. 2): durable selector of the checkout path. Historical rows
// and any N-1 writer keep FIXED_TOTAL; only the new proportional checkout path
// writes PROPORTIONAL_V1. The SQL migration adds a CHECK that a proportional
// sale is priced CASH, plus the composite FK that keeps SalePayment consistent.
enum SalePricingModel {
  FIXED_TOTAL
  PROPORTIONAL_V1
}

// R3: the role a checkout payment plays in the proportional settlement.
enum CheckoutTenderRole {
  FIXED
  BALANCE
}

// R3: institution of a transfer external collection (non-cash money received
// outside the POS). OTHER carries a free-text label.
enum TransferInstitution {
  MACRO
  BBVA
  NACION
  GALICIA
  MERCADO_PAGO
  OTHER
}

// R3: lifecycle of an external (non-cash) collection.
enum ExternalCollectionStatus {
  APPLIED
  UNAPPLIED
  REFUNDED
}

// R3-A4.3: lifecycle of a durable checkout attempt (charge reservation). Shared
// by CheckoutAttempt.status and SaleCheckout.attemptStatus (same PG type).
enum CheckoutAttemptStatus {
  RESERVED
  CONFIRMED
  REJECTED
  ABANDONED
}

// R3-A4.3: a tender is new money, or an existing UNAPPLIED external collection.
enum CheckoutTenderSource {
  NEW
  COLLECTION
}

// R3-A4.3: what a terminal attempt declares per tender.
enum CheckoutDeclarationOutcome {
  NONE
  CHARGED
  RETURNED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  SALE_INCOME
  CLOSING
  MANUAL
}

enum LocationType {
  RETAIL_BRANCH
  CENTRAL_WAREHOUSE
}

// Phase 1B (Production V1): UserRoleScope's scope discriminator. See
// docs/production-v1/05-architecture.md §5 and 06-erd-data-model.md §2.2.
enum ScopeKind {
  LOCATION
  COMPANY
}

// Phase 1A (Production V1): additive Company/Location foundation, introduced
// alongside — not replacing — the Demo V2 Branch model. Existing Branch-keyed
// consumers (Sale, Inventory, StockMovement, CashRegister, AuditLog,
// UserBranchRole, SaleNumberCounter) are untouched; see
// docs/production-v1/08-implementation-roadmap.md Phase 1A/1C.
// Single-company root tenant; never physically deleted; immutable after
// creation at the service level (docs/production-v1/06-erd-data-model.md).
model Company {
  id        String   @id @default(uuid())
  name      String
  cuit      String   @unique
  address   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  locations Location[]
  pricingConfig CompanyPricingConfig?
}

model CompanyPricingConfig {
  id                        String   @id @default(uuid())
  companyId                 String   @unique
  listAdjustmentBps         Int      @default(0)
  creditCardAdjustmentBps   Int      @default(0)
  debitCardAdjustmentBps    Int      @default(0)
  bankTransferAdjustmentBps Int      @default(0)
  qrAdjustmentBps           Int      @default(0)
  createdAt                 DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @db.Timestamptz(3)
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

// Unified location (retail branch or central warehouse); backfilled from
// Branch in Phase 1A. `type` is immutable after creation at the service level.
model Location {
  id                String       @id @default(uuid())
  companyId         String
  name              String
  code              String       @unique
  type              LocationType
  address           String
  pointOfSaleNumber Int          @unique
  isActive          Boolean      @default(true)
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  roleScopes UserRoleScope[]

  @@index([type])
  @@index([isActive])
}

// UUID strings preserve compatibility with the plan's parameterized raw SQL locks.
// Monetary amounts are BigInt centavos; quantities/counters are also BigInt.
// Restrict deletion of referenced records to preserve commercial/audit history.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  branchRoles        UserBranchRole[]
  roleScopes         UserRoleScope[]
  sales              Sale[]           @relation("SaleSeller")
  wholesaleConfirmed Sale[]           @relation("SaleWholesaleConfirmedBy")
  stockMovements     StockMovement[]
  openedCashSessions CashSession[]    @relation("CashSessionOpenedBy")
  closedCashSessions CashSession[]    @relation("CashSessionClosedBy")
  cashMovements      CashMovement[]
  auditLogs          AuditLog[]
  saleCheckouts      SaleCheckout[]
  externalCollectionsRecorded ExternalCollection[] @relation("ExternalCollectionRecordedBy")
  externalCollectionsResolved ExternalCollection[] @relation("ExternalCollectionResolvedBy")
  checkoutAttemptsStarted     CheckoutAttempt[] @relation("CheckoutAttemptStartedBy")
  checkoutAttemptsConfirmed   CheckoutAttempt[] @relation("CheckoutAttemptConfirmedBy")
  checkoutAttemptsRejected    CheckoutAttempt[] @relation("CheckoutAttemptRejectedBy")
  checkoutAttemptsAbandoned   CheckoutAttempt[] @relation("CheckoutAttemptAbandonedBy")
  checkoutAttemptsDeclared    CheckoutAttempt[] @relation("CheckoutAttemptDeclaredBy")
  checkoutDeclarations        CheckoutAttemptDeclaration[]
}

model Role {
  id   String @id @default(uuid())
  code String @unique
  name String

  permissions RolePermission[]
  branchUsers UserBranchRole[]
  roleScopes  UserRoleScope[]
}

model Permission {
  id   String @id @default(uuid())
  code String @unique

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Phase 1B (Production V1): additive Role/scope model, introduced alongside —
// not replacing — Demo V2's UserBranchRole. UserBranchRole stays authoritative
// until Phase 1C backfills and switches reads/writes (expand-and-contract,
// docs/development/migrations.md §16). No rows are written to this table in
// Phase 1B; the CHECK constraint and the two uniqueness-covering partial
// unique indexes below live in raw SQL appended to this migration's
// migration.sql (Prisma has no @@check and no partial-index syntax — see
// docs/development/migrations.md §12):
//   - CHECK chk_user_role_scope_consistency:
//       (scopeKind = 'LOCATION' AND locationId IS NOT NULL)
//       OR (scopeKind = 'COMPANY' AND locationId IS NULL)
//   - uq_user_role_scope_location: UNIQUE (userId, roleId, scopeKind, locationId)
//       WHERE locationId IS NOT NULL
//   - uq_user_role_scope_company: UNIQUE (userId, roleId, scopeKind)
//       WHERE locationId IS NULL
// (a plain Prisma @@unique treats NULL as distinct and would not stop
// duplicate COMPANY-scope rows for the same user+role, per
// docs/production-v1/05-architecture.md §5 — the two partial indexes above
// are this project's chosen "equivalent partial unique index strategy" in
// place of NULLS NOT DISTINCT, consistent with the existing
// cash_session_one_open_per_register precedent.)
//
// Phase 1C addendum: UserRoleScope is now backfilled from UserBranchRole
// (scope-backfill.service.ts) and is the authoritative LOCATION/COMPANY
// scope source read at request time (api/src/modules/rbac/effective-branch-ids.ts,
// consumed by api/src/middleware/auth.ts and auth.service.ts) — falling back
// to UserBranchRole only where a user has not been backfilled yet. Role code
// and permission vocabulary resolution stay on UserBranchRole/legacy
// Role/Permission until Phase 1D.
model UserRoleScope {
  id         String    @id @default(uuid())
  userId     String
  roleId     String
  scopeKind  ScopeKind @default(LOCATION)
  locationId String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([roleId])
  @@index([scopeKind])
}

model Branch {
  id                String @id @default(uuid())
  name              String
  code              String @unique
  address           String
  pointOfSaleNumber Int

  userRoles         UserBranchRole[]
  inventory         Inventory[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  sales             Sale[]
  cashRegisters     CashRegister[]
  auditLogs         AuditLog[]
  // Task 5 creates the counter with the branch; branchId uniqueness prevents duplicates.
  saleNumberCounter SaleNumberCounter?
  // R3 proportional checkout.
  saleCheckouts       SaleCheckout[]
  externalCollections ExternalCollection[]
}

// Phase 1C (Production V1) DEPRECATE step — transitional split, not a full
// handoff: UserRoleScope (backfilled 1:1 from this table by
// api/src/modules/rbac/scope-backfill.service.ts) is now the authoritative
// source for LOCATION/COMPANY scope resolution (`req.auth.branchIds`, wired
// in api/src/middleware/auth.ts and api/src/modules/auth/auth.service.ts,
// with a fallback to this table's data where UserRoleScope has not been
// backfilled yet). This table remains the sole, unmodified source for role
// codes and the legacy permission vocabulary (`req.auth.roles`/
// `req.auth.permissions`) until Phase 1D. REMOVE happens only after that
// full compatibility window closes (docs/development/migrations.md §16).
model UserBranchRole {
  id       String @id @default(uuid())
  userId   String
  branchId String
  roleId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, branchId, roleId])
  @@index([branchId])
  @@index([roleId])
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  products Product[]
}

model Brand {
  id   String @id @default(uuid())
  name String @unique

  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  categoryId  String
  brandId     String
  isActive    Boolean  @default(true)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)

  variants  ProductVariant[]
  saleItems SaleItem[]

  @@index([categoryId])
  @@index([brandId])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  sku       String  @unique
  barcode   String  @unique
  color     String?
  size      String?
  // Transitional legacy LIST price, centavos. 2026-10-06 supersession:
  // target retail base is cashPrice; price remains LIST during migration.
  price     BigInt
  // Pilot Pricing V2: explicit retail CASH base. NULL means existing data
  // has not been backfilled/verified yet; runtime pricing fails closed.
  cashPrice BigInt?
  // Block 1: optional wholesale price, centavos. NULL means "no wholesale
  // price": a WHOLESALE sale cannot carry this variant (fails closed). From
  // 2026-10-06 onward this is the wholesale CASH base.
  wholesalePrice BigInt?
  costPrice BigInt
  isActive  Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  inventory         Inventory[]
  stockReservations StockReservation[]
  saleItems         SaleItem[]

  @@index([productId])
}

model Inventory {
  id        String         @id @default(uuid())
  variantId String
  branchId  String
  physical  BigInt         @default(0)
  reserved  BigInt         @default(0)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)

  stockMovements StockMovement[]

  @@unique([variantId, branchId])
  @@index([branchId])
}

model StockMovement {
  id            String            @id @default(uuid())
  inventoryId   String
  type          StockMovementType
  quantityDelta BigInt
  saleId        String?
  userId        String
  branchId      String
  timestamp     DateTime          @default(now()) @db.Timestamptz(3)
  inventory     Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  sale          Sale?             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([inventoryId, timestamp])
  @@index([saleId])
  @@index([userId])
  @@index([branchId, timestamp])
}

model StockReservation {
  id        String                 @id @default(uuid())
  saleId    String
  variantId String
  branchId  String
  quantity  BigInt
  expiresAt DateTime               @db.Timestamptz(3)
  status    StockReservationStatus @default(ACTIVE)
  sale      Sale                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  variant   ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  branch    Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([saleId, status])
  @@index([variantId, branchId])
  @@index([branchId])
  @@index([status, expiresAt])
}

model Sale {
  id            String     @id @default(uuid())
  // Allocated at DRAFT -> PENDING_PAYMENT; unrelated to fiscal/ARCA numbering.
  saleNumber    String?
  branchId      String
  sellerId      String
  status        SaleStatus @default(DRAFT)
  subtotal      BigInt     @default(0)
  discountTotal BigInt     @default(0)
  total         BigInt     @default(0)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  seller        User       @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  // Block 1: sale-scoped wholesale state. Only the sale's own seller can
  // activate WHOLESALE (a server-validated code; the code itself is never
  // stored), so the authorizing actor is sellerId. A cashier at the sale's
  // location must confirm before the sale accepts a payment or completes.
  // DB CHECKs: LIST rows carry none of these; a WHOLESALE sale was
  // authorized and can never be PAID or COMPLETED without a confirmation.
  pricingMode            PriceType @default(LIST)
  // Pilot Pricing V2: one customer-facing price mode per sale. It is fixed
  // before payment collection and distinct from pricingMode's retail/
  // wholesale base-tier fact above. New sales default to CASH; rows that
  // existed before the migration were backfilled LIST (they were priced at list).
  priceMode              CustomerPriceMode @default(CASH)
  wholesaleAuthorizedAt  DateTime? @db.Timestamptz(3)
  wholesaleConfirmedById String?
  wholesaleConfirmedAt   DateTime? @db.Timestamptz(3)
  wholesaleConfirmedBy   User?     @relation("SaleWholesaleConfirmedBy", fields: [wholesaleConfirmedById], references: [id], onDelete: Restrict)
  // Block 1: durable payment history — the earliest persisted
  // SalePayment.paidAt this sale has ever had. Maintained ONLY by DB
  // triggers on SalePayment, in the same transaction as the payment change;
  // it may move earlier, never later or back to NULL, and cannot be set
  // without real payment evidence. Deleting, moving or truncating payment
  // rows never erases it; while the sale has payment history, pricingMode
  // and the wholesale columns above are frozen by a DB trigger.
  paymentStartedAt       DateTime? @db.Timestamptz(3)

  // R3 rev. 2: durable checkout-path selector. Existing rows and any write from
  // an N-1 API default to FIXED_TOTAL; only the proportional checkout path
  // writes PROPORTIONAL_V1. See the SQL migration for the CHECK tying a
  // proportional sale to priceMode = CASH and the composite FKs below.
  pricingModel SalePricingModel @default(FIXED_TOTAL)

  items             SaleItem[]
  payments          SalePayment[] @relation("SaleToSalePayment")
  pricingModelPayments SalePayment[] @relation("SalePaymentPricingModel")
  stockReservations StockReservation[]
  stockMovements    StockMovement[]
  checkouts         SaleCheckout[]
  checkoutAttempts  CheckoutAttempt[]
  externalOrigins   ExternalCollection[] @relation("ExternalCollectionOriginSale")

  @@unique([branchId, saleNumber])
  @@unique([id, branchId], map: "Sale_id_branchId_key")
  @@unique([id, pricingModel], map: "Sale_id_pricingModel_key")
  @@unique([id, branchId, pricingModel], map: "Sale_id_branchId_pricingModel_key")
  @@index([branchId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([status, createdAt])
}

model SaleItem {
  id          String         @id @default(uuid())
  saleId      String
  variantId   String
  productId   String
  productName String
  variantName String
  sku         String
  quantity    BigInt
  // Pilot Pricing V2 immutable explanation snapshot. unitPrice remains the
  // authoritative final money snapshot; these fields explain how it was
  // derived and remain nullable for pre-migration rows.
  priceBaseType           PriceType?
  priceMode               CustomerPriceMode?
  baseUnitPrice           BigInt?
  priceAdjustmentBps      Int?
  pricingConfigId         String?
  pricingConfigUpdatedAt  DateTime? @db.Timestamptz(3)
  unitPrice   BigInt
  subtotal    BigInt
  sale        Sale           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  allocations SaleLineAllocation[]

  @@index([saleId])
  @@index([variantId])
  @@index([productId])
  @@unique([id, saleId], map: "SaleItem_id_saleId_key")
}

model SalePayment {
  id             String        @id @default(uuid())
  saleId         String
  method         PaymentMethod
  amount         BigInt
  receivedAmount BigInt?
  changeAmount   BigInt?
  cashSessionId  String?
  idempotencyKey String
  paidAt         DateTime      @default(now()) @db.Timestamptz(3)
  // R3 rev. 2: durable pricing-model selector, defaulted for historical and
  // N-1 writers. The composite FK to Sale(id, pricingModel) makes it consistent
  // with the sale: a historical writer cannot settle a PROPORTIONAL_V1 sale.
  pricingModel         SalePricingModel  @default(FIXED_TOTAL)
  // R3 proportional-checkout shape. All NULL for historical/fixed-total rows.
  checkoutId           String?
  tenderRole           CheckoutTenderRole?
  methodFullPrice      BigInt?
  adjustmentBps        Int?
  externalCollectionId String?           @unique(map: "SalePayment_externalCollectionId_key")

  sale          Sale        @relation("SaleToSalePayment", fields: [saleId], references: [id], onDelete: Restrict)
  pricingSale   Sale        @relation("SalePaymentPricingModel", fields: [saleId, pricingModel], references: [id, pricingModel], onDelete: Restrict, onUpdate: Restrict, map: "SalePayment_sale_pricing_model_fkey")
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  checkout      SaleCheckout? @relation(fields: [checkoutId, saleId, cashSessionId], references: [id, saleId, cashSessionId], onDelete: Restrict, onUpdate: Restrict, map: "SalePayment_checkout_fkey")
  // Same applied sale, method and exact amount as the external collection.
  externalCollection ExternalCollection? @relation(fields: [externalCollectionId, saleId, method, amount], references: [id, appliedSaleId, method, amount], onDelete: Restrict, onUpdate: Restrict, map: "SalePayment_external_collection_fkey")

  cashMovement CashMovement?
  allocations  SaleLineAllocation[]

  @@unique([saleId, idempotencyKey])
  @@unique([checkoutId, method], map: "SalePayment_checkoutId_method_key")
  @@unique([id, checkoutId, method], map: "SalePayment_id_checkoutId_method_key")
  @@index([cashSessionId])
}

model CashRegister {
  id       String @id @default(uuid())
  branchId String
  name     String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  sessions CashSession[]

  // Register names identify a register within its branch, not globally.
  @@unique([branchId, name])
}

model CashSession {
  id           String            @id @default(uuid())
  registerId   String
  openedById   String
  openedAt     DateTime          @default(now()) @db.Timestamptz(3)
  closedById   String?
  closedAt     DateTime?         @db.Timestamptz(3)
  startingCash BigInt
  // CASH-1 (FR-CASH-001): reconciliation of the operational close. Nullable by
  // design: sessions closed before CASH-1 keep these NULL forever and must
  // never be presented as reconciled. expectedCash = startingCash + the net
  // SALE_INCOME movements; difference = countedCash - expectedCash.
  expectedCash BigInt?
  countedCash  BigInt?
  difference   BigInt?
  status       CashSessionStatus @default(OPEN)
  register     CashRegister      @relation(fields: [registerId], references: [id], onDelete: Restrict)
  openedBy     User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy     User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)

  payments  SalePayment[]
  movements CashMovement[]
  saleCheckouts       SaleCheckout[]
  externalCollections ExternalCollection[]
  checkoutAttempts    CheckoutAttempt[]

  // The initial migration adds cash_session_one_open_per_register as a partial
  // unique index. CLOSED sessions must remain unlimited for each register.
  @@index([registerId, status])
  @@index([openedById])
  @@index([closedById])
}

model CashMovement {
  id            String           @id @default(uuid())
  sessionId     String
  type          CashMovementType
  amount        BigInt
  // A payment can produce at most one income movement, including under retries.
  salePaymentId String?          @unique
  userId        String
  timestamp     DateTime         @default(now()) @db.Timestamptz(3)
  session       CashSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  salePayment   SalePayment?     @relation(fields: [salePaymentId], references: [id], onDelete: Restrict)
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sessionId, timestamp])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  // D3: nullable for global COMPANY-scoped operations (product, variant,
  // price) that have no Location. Location-specific operations always record
  // their real branch.
  branchId   String?
  action     String
  entityType String
  entityId   String
  // Task 20 normalizes BigInt values via toJsonSafe before writing these JSON fields.
  before     Json?
  after      Json?
  timestamp  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, timestamp])
  @@index([entityType, entityId, timestamp])
  @@index([userId, timestamp])
}

model SaleNumberCounter {
  id        String @id @default(uuid())
  branchId  String @unique
  nextValue BigInt @default(1)
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
}

// R3 (design rev. 2): one durable record per completed proportional checkout.
// Money is BigInt centavos; calculated values (full prices, balance, total) are
// whole pesos, while received fixed amounts keep exact centavos. The raw SQL
// migration adds the CHECK constraints and partial indexes below (Prisma cannot
// express @@check or partial unique indexes).
//
// SQL-only constraints:
//   chk_checkout_model             pricingModel = 'PROPORTIONAL_V1' AND algorithmVersion = 1
//   chk_checkout_hash              requestHash ~ '^[0-9a-f]{64}$'
//   chk_checkout_balance_method    balanceMethod IN ('CASH','TRANSFER','CARD_DEBIT')
//   chk_checkout_amounts           total > 0 AND changeAmount >= 0 AND referenceSubtotal > 0
//                                    AND fullPriceCash > 0 AND fullPriceCash % 100 = 0
//   chk_checkout_config_snapshot   the pricing-config snapshot is all-or-nothing
//                                    (pricingConfigId, pricingConfigUpdatedAt, both
//                                    full prices and both adjustment bps NULL together,
//                                    or all present and in range)
//   chk_checkout_attempt_status    attemptStatus = 'CONFIRMED' (R3-A4.3)
model SaleCheckout {
  id                    String            @id @default(uuid())
  saleId                String            @unique(map: "SaleCheckout_saleId_key")
  branchId              String
  pricingModel          SalePricingModel
  operationKey          String            @unique(map: "SaleCheckout_operationKey_key") @db.Uuid
  requestHash           String            @db.Char(64)
  cashSessionId         String
  userId                String
  balanceMethod         PaymentMethod
  // Sale.subtotal at checkout time (the cash reference); total is the final one.
  referenceSubtotal     BigInt
  total                 BigInt
  changeAmount          BigInt            @default(0)
  fullPriceCash         BigInt
  fullPriceTransfer     BigInt?
  fullPriceDebit        BigInt?
  transferAdjustmentBps Int?
  debitAdjustmentBps    Int?
  pricingConfigId       String?
  pricingConfigUpdatedAt DateTime?        @db.Timestamptz(3)
  algorithmVersion      Int
  completedAt           DateTime          @default(now()) @db.Timestamptz(3)
  // R3-A4.3: always CONFIRMED (chk_checkout_attempt_status); part of the FK
  // that requires the CONFIRMED attempt carrying the same hash.
  attemptStatus         CheckoutAttemptStatus @default(CONFIRMED)

  // Immutable link to the sale's branch and model (ON UPDATE RESTRICT).
  sale        Sale        @relation(fields: [saleId, branchId, pricingModel], references: [id, branchId, pricingModel], onDelete: Restrict, onUpdate: Restrict, map: "SaleCheckout_sale_branch_model_fkey")
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  // R3-A4.3: no checkout without a CONFIRMED attempt with requestHash =
  // confirmationHash; ON UPDATE RESTRICT (and F1) freezes that attempt.
  attempt     CheckoutAttempt @relation("SaleCheckoutAttempt", fields: [operationKey, saleId, attemptStatus, requestHash], references: [operationKey, saleId, status, confirmationHash], onDelete: Restrict, onUpdate: Restrict, map: "SaleCheckout_attempt_fkey")

  payments            SalePayment[]
  allocations         SaleLineAllocation[]
  externalCollections ExternalCollection[] @relation("ExternalCollectionAppliedCheckout")

  @@unique([id, saleId], map: "SaleCheckout_id_saleId_key")
  @@unique([id, saleId, cashSessionId], map: "SaleCheckout_id_saleId_cashSessionId_key")
  @@unique([id, saleId, branchId], map: "SaleCheckout_id_saleId_branchId_key")
  @@unique([operationKey, saleId, attemptStatus, requestHash], map: "SaleCheckout_attempt_link_key")
}

// R3 (design rev. 2): a non-cash collection (transfer or debit) received outside
// the POS. It is the durable source of reference/institution uniqueness, being
// either APPLIED to a checkout or UNAPPLIED as a supervised incident.
//
// SQL-only constraints:
//   chk_ec_amount        amount > 0
//   chk_ec_reference     char_length(reference) BETWEEN 1 AND 64
//                          AND referenceKey ~ '^[A-Z0-9]{3,40}$'
//   chk_ec_institution   three explicit NULL-safe forms (debit, normal transfer,
//                          OTHER transfer); implies method in {TRANSFER, CARD_DEBIT}
//   chk_ec_status         three explicit NULL-safe forms keyed by status
//   ExternalCollection_debit_ref_key     partial unique (branchId, referenceKey)
//                                          WHERE method = 'CARD_DEBIT'
//   ExternalCollection_transfer_ref_key  partial unique (branchId, institution,
//                                          referenceKey) WHERE method = 'TRANSFER'
//   chk_ec_origin_attempt  originAttemptId IS NULL OR originSaleId IS NOT NULL (R3-A4.3)
//   chk_ec_claim_state     status <> 'REFUNDED' OR claimAttemptId IS NULL (R3-A4.3)
//   chk_ec_refund_fields   REFUNDED <=> externalRefundedAt set, <= resolvedAt, with a
//                            10..500-char resolutionNote and no claim (R3-A4.3)
//   fn_external_collection_guard (trigger, R3-A4.3): rows are permanent; financial
//     and origin data immutable; resolution write-once; status only UNAPPLIED ->
//     APPLIED (by the claiming attempt's checkout) | REFUNDED (unclaimed); claim
//     NULL -> X only from X's unsealed RESERVED plan holding it as COLLECTION,
//     X -> NULL only once X is terminal and declared, never X -> Y.
model ExternalCollection {
  id               String                   @id @default(uuid())
  branchId         String
  method           PaymentMethod
  // Exact centavos received.
  amount           BigInt
  reference        String
  referenceKey     String
  institution      TransferInstitution?
  institutionOther String?
  status           ExternalCollectionStatus
  // Sale where the incident happened (may later be cancelled).
  originSaleId     String?
  cashSessionId    String?
  // Sale the collection was finally applied to.
  appliedCheckoutId String?
  appliedSaleId    String?
  recordedById     String
  recordedAt       DateTime                 @default(now()) @db.Timestamptz(3)
  incidentReason   String?
  resolvedById     String?
  resolvedAt       DateTime?                @db.Timestamptz(3)
  refundReference  String?
  resolutionNote   String?
  // R3-A4.3: the attempt whose declaration recorded it (CHARGED, UNAPPLIED).
  originAttemptId  String?
  // R3-A4.3: the open attempt holding it as a COLLECTION tender (at most one).
  claimAttemptId   String?
  // R3-A4.3: when the refund was executed outside the POS (REFUNDED only).
  externalRefundedAt DateTime?              @db.Timestamptz(3)

  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Same branch as the incident: (originSaleId, branchId) -> Sale(id, branchId).
  originSale      Sale?         @relation("ExternalCollectionOriginSale", fields: [originSaleId, branchId], references: [id, branchId], onDelete: Restrict, onUpdate: Restrict, map: "ExternalCollection_origin_sale_fkey")
  // Same branch as the applied checkout: (appliedCheckoutId, appliedSaleId,
  // branchId) -> SaleCheckout(id, saleId, branchId). A collection cannot be
  // applied across branches.
  appliedCheckout SaleCheckout? @relation("ExternalCollectionAppliedCheckout", fields: [appliedCheckoutId, appliedSaleId, branchId], references: [id, saleId, branchId], onDelete: Restrict, onUpdate: Restrict, map: "ExternalCollection_applied_fkey")
  cashSession     CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  recordedBy      User          @relation("ExternalCollectionRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  resolvedBy      User?         @relation("ExternalCollectionResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  // Same attempt, sale and branch as its origin declaration.
  originAttempt   CheckoutAttempt? @relation("ExternalCollectionOriginAttempt", fields: [originAttemptId, originSaleId, branchId], references: [id, saleId, branchId], onDelete: Restrict, onUpdate: Restrict, map: "ExternalCollection_origin_attempt_fkey")
  claimAttempt    CheckoutAttempt? @relation("ExternalCollectionClaimAttempt", fields: [claimAttemptId, branchId], references: [id, branchId], onDelete: Restrict, onUpdate: Restrict, map: "ExternalCollection_claim_fkey")

  // Applying the same collection twice is impossible: the payment FK target.
  payments     SalePayment[]
  tenders      CheckoutAttemptTender[]      @relation("CheckoutAttemptTenderCollection")
  declarations CheckoutAttemptDeclaration[] @relation("CheckoutAttemptDeclarationCollection")

  @@unique([id, appliedSaleId, method, amount], map: "ExternalCollection_id_applied_key")
  @@unique([id, branchId, method, amount], map: "ExternalCollection_id_branch_method_amount_key")
  @@unique([id, originAttemptId, originSaleId, branchId, method], map: "ExternalCollection_id_origin_attempt_key")
  @@index([claimAttemptId], map: "ExternalCollection_claimAttemptId_idx")
}

// R3 (design rev. 2): the exact per-line amount each checkout payment settles.
//
// SQL-only constraint:
//   chk_alloc   quantity > 0 AND baseUnitPrice > 0 AND unitPrice > 0
//                 AND unitPrice % 100 = 0 AND lineFullPrice = quantity * unitPrice
//                 AND amount >= 0 AND amount <= lineFullPrice
model SaleLineAllocation {
  id            String        @id @default(uuid())
  checkoutId    String
  saleId        String
  saleItemId    String
  salePaymentId String
  method        PaymentMethod
  quantity      BigInt
  baseUnitPrice BigInt
  unitPrice     BigInt
  lineFullPrice BigInt
  amount        BigInt

  checkout  SaleCheckout @relation(fields: [checkoutId, saleId], references: [id, saleId], onDelete: Restrict, onUpdate: Restrict, map: "SaleLineAllocation_checkout_fkey")
  // The allocation belongs to the payment, the checkout and the method.
  payment   SalePayment  @relation(fields: [salePaymentId, checkoutId, method], references: [id, checkoutId, method], onDelete: Restrict, onUpdate: Restrict, map: "SaleLineAllocation_payment_fkey")
  // The allotted line belongs to the same sale.
  saleItem  SaleItem     @relation(fields: [saleItemId, saleId], references: [id, saleId], onDelete: Restrict, onUpdate: Restrict, map: "SaleLineAllocation_item_fkey")

  @@unique([salePaymentId, saleItemId], map: "SaleLineAllocation_payment_item_key")
  @@index([checkoutId], map: "SaleLineAllocation_checkoutId_idx")
  @@index([saleItemId], map: "SaleLineAllocation_saleItemId_idx")
}

// R3-A4.3: a durable charge reservation (checkout attempt). The plan is sealed
// at reservation; confirmation, rejection, abandonment and declaration are
// recorded on the same row. The charge reservation never expires (stock holds
// keep their usual expiry). Money is BigInt centavos.
//
// SQL-only (migration 20261016130000_r3_checkout_attempts):
//   chk_attempt_hashes            planHash / confirmationHash are 64 lowercase hex
//   chk_attempt_plan              balanceMethod, positive totals, whole-peso balance
//                                   and cash full price, 1..3 tenders, algorithmVersion = 1
//   chk_attempt_pricing_snapshot  pricing-config snapshot all-or-nothing
//   chk_attempt_texts             supervisor reason 10..500 / evidence 3..200
//   chk_attempt_status_fields     NULL-safe column set of each status
//   chk_attempt_recovery          recoveryReason/recoveryEvidence both NULL or both valid
//   CheckoutAttempt_one_open_per_sale  partial unique (saleId)
//                                   WHERE status IN ('RESERVED','REJECTED') AND declaredAt IS NULL
//   fn_checkout_attempt_guard         (trigger F1) no delete; plan frozen; sealing and
//                                       status transitions closed; outcome frozen; declaration once
//   fn_checkout_attempt_commit_check  (deferred trigger F3) sealed complete plan; complete
//                                       single-actor declaration; claim state per status
model CheckoutAttempt {
  id                     String                @id @default(uuid())
  saleId                 String
  branchId               String
  reserveKey             String                @unique(map: "CheckoutAttempt_reserveKey_key") @db.Uuid
  operationKey           String                @unique(map: "CheckoutAttempt_operationKey_key") @db.Uuid
  planHash               String                @db.Char(64)
  cashSessionId          String
  balanceMethod          PaymentMethod
  expectedTotal          BigInt
  expectedBalanceAmount  BigInt
  tenderCount            Int
  fullPriceCash          BigInt
  fullPriceTransfer      BigInt?
  fullPriceDebit         BigInt?
  transferAdjustmentBps  Int?
  debitAdjustmentBps     Int?
  pricingConfigId        String?
  pricingConfigUpdatedAt DateTime?             @db.Timestamptz(3)
  algorithmVersion       Int
  planSealed             Boolean               @default(false)
  status                 CheckoutAttemptStatus @default(RESERVED)
  startedById            String
  startedAt              DateTime              @default(now()) @db.Timestamptz(3)
  recoveryReason         String?
  recoveryEvidence       String?
  confirmationHash       String?               @db.Char(64)
  confirmedById          String?
  confirmedAt            DateTime?             @db.Timestamptz(3)
  confirmReason          String?
  confirmEvidence        String?
  rejectionCode          String?
  rejectionDetails       Json?
  rejectedById           String?
  rejectedAt             DateTime?             @db.Timestamptz(3)
  abandonedById          String?
  abandonedAt            DateTime?             @db.Timestamptz(3)
  abandonReason          String?
  abandonEvidence        String?
  declaredById           String?
  declaredAt             DateTime?             @db.Timestamptz(3)

  sale        Sale        @relation(fields: [saleId, branchId], references: [id, branchId], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttempt_sale_branch_fkey")
  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttempt_cashSessionId_fkey")
  startedBy   User        @relation("CheckoutAttemptStartedBy", fields: [startedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttempt_startedById_fkey")
  confirmedBy User?       @relation("CheckoutAttemptConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttempt_confirmedById_fkey")
  rejectedBy  User?       @relation("CheckoutAttemptRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttempt_rejectedById_fkey")
  abandonedBy User?       @relation("CheckoutAttemptAbandonedBy", fields: [abandonedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttempt_abandonedById_fkey")
  declaredBy  User?       @relation("CheckoutAttemptDeclaredBy", fields: [declaredById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttempt_declaredById_fkey")

  tenders            CheckoutAttemptTender[]
  declarations       CheckoutAttemptDeclaration[]
  checkout           SaleCheckout?                @relation("SaleCheckoutAttempt")
  originCollections  ExternalCollection[]         @relation("ExternalCollectionOriginAttempt")
  claimedCollections ExternalCollection[]         @relation("ExternalCollectionClaimAttempt")

  @@unique([id, branchId], map: "CheckoutAttempt_id_branchId_key")
  @@unique([id, saleId, branchId], map: "CheckoutAttempt_id_saleId_branchId_key")
  @@unique([operationKey, saleId, status, confirmationHash], map: "CheckoutAttempt_confirmation_key")
  @@index([branchId, startedById, startedAt(sort: Desc)], map: "CheckoutAttempt_branch_starter_time_idx")
  @@index([branchId, startedAt(sort: Desc)], map: "CheckoutAttempt_branch_time_idx")
}

// R3-A4.3: one tender of a sealed attempt plan.
//
// SQL-only:
//   chk_tender_shape                  BALANCE+NEW without amount; FIXED+NEW with amount > 0;
//                                       FIXED+COLLECTION (TRANSFER/CARD_DEBIT) with amount and collection
//   CheckoutAttemptTender_one_balance  partial unique (attemptId) WHERE role = 'BALANCE'
//   fn_checkout_attempt_tender_guard  (trigger F2) insert-only, only into an unsealed RESERVED attempt
model CheckoutAttemptTender {
  id                   String               @id @default(uuid())
  attemptId            String
  branchId             String
  method               PaymentMethod
  role                 CheckoutTenderRole
  source               CheckoutTenderSource
  amount               BigInt?
  externalCollectionId String?

  attempt            CheckoutAttempt     @relation(fields: [attemptId, branchId], references: [id, branchId], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttemptTender_attempt_fkey")
  // A COLLECTION tender is the same collection: same branch, method and exact amount.
  externalCollection ExternalCollection? @relation("CheckoutAttemptTenderCollection", fields: [externalCollectionId, branchId, method, amount], references: [id, branchId, method, amount], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttemptTender_collection_fkey")

  declarations CheckoutAttemptDeclaration[]

  @@unique([attemptId, method], map: "CheckoutAttemptTender_attempt_method_key")
  @@unique([attemptId, method, source], map: "CheckoutAttemptTender_attempt_method_source_key")
}

// R3-A4.3: per-tender declaration of a terminal (REJECTED/ABANDONED) attempt.
//
// SQL-only:
//   chk_declaration_shape     CASH: NONE | RETURNED (amount + evidence); TRANSFER/CARD_DEBIT:
//                               NONE | CHARGED (NEW tender only, collection + evidence)
//   chk_declaration_evidence  evidence 3..200 when present
//   fn_checkout_attempt_declaration_guard  (trigger F4) insert-only into a terminal undeclared
//                               attempt; non-initiator needs evidence; CHARGED needs an UNAPPLIED
//                               collection recorded by the declarer
//   fn_checkout_declaration_commit_check   (deferred trigger F5) the attempt is declared at commit
model CheckoutAttemptDeclaration {
  id                   String                     @id @default(uuid())
  attemptId            String
  saleId               String
  branchId             String
  method               PaymentMethod
  tenderSource         CheckoutTenderSource
  outcome              CheckoutDeclarationOutcome
  externalCollectionId String?                    @unique(map: "CheckoutAttemptDeclaration_externalCollectionId_key")
  returnedAmount       BigInt?
  evidence             String?
  declaredById         String
  declaredAt           DateTime                   @default(now()) @db.Timestamptz(3)

  tender             CheckoutAttemptTender @relation(fields: [attemptId, method, tenderSource], references: [attemptId, method, source], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttemptDeclaration_tender_fkey")
  attempt            CheckoutAttempt       @relation(fields: [attemptId, saleId, branchId], references: [id, saleId, branchId], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttemptDeclaration_attempt_fkey")
  // CHARGED: same attempt, sale, branch and method as the collection it recorded.
  externalCollection ExternalCollection?   @relation("CheckoutAttemptDeclarationCollection", fields: [externalCollectionId, attemptId, saleId, branchId, method], references: [id, originAttemptId, originSaleId, branchId, method], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttemptDeclaration_collection_fkey")
  declaredBy         User                  @relation(fields: [declaredById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "CheckoutAttemptDeclaration_declaredById_fkey")

  @@unique([attemptId, method], map: "CheckoutAttemptDeclaration_attempt_method_key")
}
