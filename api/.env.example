# PLACEHOLDERS ONLY. Real development values belong in the repository-root
# ../.env.development; never copy them into api/.env or duplicate credentials.
# Existing process environment values take precedence. Production uses process env.
# DATABASE_URL and TEST_DATABASE_URL are server-only; never NEXT_PUBLIC_* or VITE_*.
# Use the existing Supavisor Session pooler :5432 URLs without TLS query options.
# DATABASE_URL is required (runtime and build). TEST_DATABASE_URL is required
# only for NODE_ENV=test integration runs; production does not need it.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
TEST_DATABASE_URL=postgresql://<user>:<password>@<different-host>:5432/<database>
# Explicit API_PORT wins; otherwise a host-provided PORT; otherwise 3001.
API_PORT=3001
# Supply a random secret of at least 32 characters; this placeholder is rejected.
JWT_SECRET=<replace-with-a-random-secret-of-at-least-32-characters>
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Pilot expired-hold sweeper (writes automatically). Opt-in: exactly true or
# false. Requires the system actor (scripts/bootstrap-system-actor.ts) first.
RESERVATION_SWEEPER_ENABLED=false
# Delay between sweeps in ms; integer >= 1000.
RESERVATION_SWEEP_INTERVAL_MS=60000
# Max candidate Sales per sweep; integer 1..100.
RESERVATION_SWEEP_BATCH_SIZE=100
