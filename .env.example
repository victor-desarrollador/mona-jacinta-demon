# Mona Jacinta Demo V2 — environment template. Copy to .env.development / app-specific .env files and fill in LOCAL demo values. Placeholders only — never commit real secrets.

# PostgreSQL (Task 2 — docker-compose dev database, port 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-demo-only
POSTGRES_DB=mona_jacinta_demo
DATABASE_URL=postgresql://postgres:change-me-demo-only@localhost:5432/mona_jacinta_demo
TEST_DATABASE_URL=postgresql://postgres:change-me-demo-only@localhost:5433/mona_jacinta_demo_test

# API (Task 3 — Express + Prisma, port 3001)
API_PORT=3001
JWT_SECRET=replace-with-long-random-string-demo-only
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Client app (Task 22 — Next.js, port 3000)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Admin app (Task 25 — Vite, port 5173)
VITE_API_URL=http://localhost:3001
