# Mona Jacinta Demo V2 — environment template. Copy to .env.development / app-specific .env files and fill in LOCAL demo values. Placeholders only — never commit real secrets.

# PostgreSQL — hosted Supabase projects (Task 2). SERVER-ONLY secrets:
# never expose as NEXT_PUBLIC_* / VITE_* variables and never commit real values.
# Copy real connection strings into the untracked local .env.development.
# DATABASE_URL      -> REQUIRED: the runtime database, also needed by `npm run build` (prisma generate loads it).
# TEST_DATABASE_URL -> REQUIRED only for integration tests (NODE_ENV=test); MUST be a physically
#                      separate project. Not needed by, and never set for, a production/demo runtime.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
TEST_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# API (Task 3 — Express + Prisma, port 3001)
# API_PORT is the explicit Mona port and wins. If unset, a host-provided PORT is
# used; if neither is set, 3001.
API_PORT=3001
# PORT=
JWT_SECRET=replace-with-long-random-string-demo-only
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Demo seed/reset CLIs only (never read by the API runtime). Optional operator
# password for a PUBLIC demo database; unset => local/TEST default `demo123`.
# 16+ characters, at most 72 bytes, no leading/trailing spaces. Provide it in the
# operator's shell for the seed command only; never commit a real value.
# DEMO_SEED_PASSWORD=

# Client app (Task 22 — Next.js, port 3000)
# Both frontends append routes such as /auth/login directly to their API URL,
# so it must include the /api/v1 prefix. Next reads client/.env*, Vite reads
# admin/.env*; build-time values are baked into the bundle.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Admin app (Task 25 — Vite, port 5173)
VITE_API_URL=http://localhost:3001/api/v1
