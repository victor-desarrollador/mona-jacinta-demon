{
  "$schema": "https://opencode.ai/config.json",

  "model": "llama.cpp/qwen3.8-27b",

  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen Local - llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B Local",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },

  "permission": {
    "edit": "deny",
    "bash": "ask"
  },

  "compaction": {
    "auto": true,
    "prune": true
  }
}
